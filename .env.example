# Скопіюйте у .env.local і заповніть. .env.local не потрапляє в git.
# У фронт (VITE_*) кладемо ЛИШЕ публічні ключі.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# mock | duffel
VITE_FLIGHTS_PROVIDER=mock

# Секретні ключі (Stripe secret, Duffel, LiteAPI, Resend) сюди НЕ пишемо:
# вони живуть у `supabase secrets set ...`
